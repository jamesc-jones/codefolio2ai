# Copy this file to .env and fill in your local values.
# Never commit .env — it is gitignored and contains local Docker credentials only.
# These values configure the local PostgreSQL container via docker-compose.yml
# and are NOT used directly by the ASP.NET Core application.

POSTGRES_DB=CodeFolioDB
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
